# Copy to .env.local. Nothing here is secret — NEXT_PUBLIC_ variables are inlined
# into the browser bundle at build time, so changing one means rebuilding.

# Card art CDN. When set, images come from the WebP bundle on Cloudflare Pages
# instead of the local /art/[id] proxy. No trailing slash.
#
#   npm run build:cdn      convert public/cards -> cdn/
#   npm run deploy:cdn     upload cdn/ to Cloudflare Pages
#
# Leave it unset for local development: the proxy answers instead, and that is
# also what fills public/cards in the first place. `npm run build:static` does
# require it — an export has no proxy, so every image would 404.
NEXT_PUBLIC_CDN_URL=https://poneglyph-art.pages.dev

# ---------------------------------------------------------------- GitHub Pages
# Only needed for `npm run build:static` and `npm run deploy:site`.

# Where the site is served from, for sitemap.xml and robots.txt.
# NEXT_PUBLIC_SITE_URL=https://<user>.github.io/<repo>

# The subpath, if it is a project page. A repository named <user>.github.io and a
# custom domain both serve from the root, and this stays empty for them.
#
# Next rewrites its own links and assets for this; it does not touch fetch(), which
# is why every payload URL goes through dataUrl() in src/lib/paths.ts.
# NEXT_PUBLIC_BASE_PATH=/<repo>

# One repository, two branches: the source on main-node, the built site on
# main-selfhost. Pages has to be pointed at that branch in the settings, which on a
# free plan means the repository must be public.
# PONEGLYPH_SITE_REMOTE=https://github.com/<user>/<repo>.git
# PONEGLYPH_SITE_BRANCH=main-selfhost
