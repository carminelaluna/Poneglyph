# Card art CDN. When set, images come from the WebP bundle on Cloudflare Pages
# instead of the local /art/[id] proxy. No trailing slash.
#
#   npm run build:cdn      convert public/cards -> cdn/
#   npm run deploy:cdn     upload cdn/ to Cloudflare Pages
#
# Leave it unset for local development: the proxy answers instead, and that is
# also what fills public/cards in the first place.
NEXT_PUBLIC_CDN_URL=https://poneglyph-art.pages.dev
