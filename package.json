{
  "name": "poneglyph",
  "version": "0.1.0",
  "private": true,
  "description": "Poneglyph - One Piece TCG card archive, database and meta site",
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "next build",
    "start": "next start -p 4321",
    "lint": "next lint",
    "ingest": "node scripts/check-sources.mjs && node scripts/ingest.mjs",
    "ingest:images": "node scripts/fetch-images.mjs",
    "ingest:full": "node scripts/ingest.mjs && node scripts/fetch-images.mjs",
    "ingest:decks": "node scripts/ingest-decks.mjs",
    "ingest:all": "node scripts/ingest.mjs && node scripts/ingest-decks.mjs",
    "ingest:spoilers": "node scripts/ingest-spoilers.mjs",
    "ingest:banlist": "node scripts/ingest-banlist.mjs",
    "ingest:topdecks": "node scripts/ingest-topdecks.mjs",
    "build:indexes": "node scripts/build-indexes.mjs",
    "check": "node scripts/check-sources.mjs",
    "build:cdn": "node scripts/build-cdn.mjs",
    "deploy:cdn": "wrangler pages deploy ./cdn --project-name poneglyph-art --branch poneglyph-art",
    "build:static": "node scripts/build-static.mjs",
    "serve:static": "node scripts/serve-static.mjs",
    "deploy:site": "node scripts/deploy-site.mjs",
    "ingest:events": "node scripts/ingest-events.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.126.0"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-linux-64": "^1.20260825.1",
    "@img/sharp-libvips-linux-x64": "^1.3.2",
    "@img/sharp-linux-x64": "^0.35.3"
  }
}
